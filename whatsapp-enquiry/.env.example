# Copy this file to ".env" (local test) and fill in your own values.
# NEVER commit .env or put real values in this example file.
# For the live Cloudflare Worker, add the same names under
# Workers -> ace-wa-enquiry -> Settings -> Variables and Secrets (token as a Secret).

# true = check everything but do NOT call WhatsApp (safe for testing). Set to false to send for real.
WHATSAPP_DRY_RUN=true

# From Meta for Developers -> your app -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The number that RECEIVES the enquiries (yours), digits only with country code, e.g. 60123456789
WHATSAPP_RECIPIENT_NUMBER=
# Use the version shown in Meta's API Setup page, e.g. v23.0
WHATSAPP_API_VERSION=v23.0

# Production: name of your approved "utility" message template (see README). Leave empty to send plain text
# (plain text only works within 24 hours after the recipient last messaged your WhatsApp business number).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Websites allowed to call this endpoint (comma separated). "null" allows the page opened as a local file.
ALLOWED_ORIGIN=http://localhost:8787,null

# Optional: Cloudflare Turnstile secret key (captcha). Leave empty to switch the captcha off.
TURNSTILE_SECRET=

# Optional: max submissions per IP address per 10 minutes (fallback limiter)
RATE_LIMIT_MAX=5
